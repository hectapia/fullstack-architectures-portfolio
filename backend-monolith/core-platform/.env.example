# ==============================================================================
# Django Core Platform Monolith - Environment Configuration
# Sprint 2 (Monolith & Core UI)
# ==============================================================================

# General Configuration
DEBUG=True
SECRET_KEY=django-insecure-generate-or-replace-with-a-production-secret-key-32-chars
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Sprint 2, Day 2: Aiven PostgreSQL via psycopg2)
# When DATABASE_URL is defined, Django connects to PostgreSQL using psycopg2.
# When omitted, Django falls back to local SQLite for isolated offline development.
#
# Aiven Cloud PostgreSQL URI Format:
# postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
#
# Example:
# DATABASE_URL=postgres://avnadmin:SecretPass123@pg-monolith-portfolio.aivencloud.com:21345/defaultdb?sslmode=require
